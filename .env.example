# Copiar a .env.local y completar. En Vercel se cargan como variables de entorno.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Lectura de tiquetes (console.anthropic.com → API Keys). Fijar límite de gasto mensual.
ANTHROPIC_API_KEY=

# Firma de las lecturas (cualquier texto largo y aleatorio)
FIRMA_LECTURA_SECRETO=

# Correo automático con Brevo (app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=
CORREO_REMITENTE=tu-correo@gmail.com
CORREO_REMITENTE_NOMBRE=BancoTicket

# URL pública de la app (para los enlaces de confirmación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege la tarea programada de borrado de fotos (Vercel la envía como Bearer)
CRON_SECRET=
